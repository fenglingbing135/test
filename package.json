{
  "name": "ai-review-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 代码审核工作台：粘贴变更或 MR 链接，得到可定位、可分级的审核问题清单",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:server": "node --watch src/server.js",
    "build": "vite build",
    "start": "node src/server.js",
    "verify": "node scripts/verify-api.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@hono/node-server": "^1.13.7",
    "antd": "^5.22.5",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}